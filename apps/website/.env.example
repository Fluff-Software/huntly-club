# Google Tag Manager container ID (e.g. GTM-XXXXXXX)
NEXT_PUBLIC_GTM_ID=

# Payload CMS
# Random 32+ char string, e.g. `openssl rand -base64 32`. Keep this secret.
PAYLOAD_SECRET=
# Direct (non-pooled, port 5432) Postgres connection string for the same
# Supabase project used elsewhere in this repo. From Supabase dashboard ->
# Project Settings -> Database -> Connection string (URI, "Direct connection").
# Payload's own tables live in a separate `payload` Postgres schema, so they
# won't collide with the product tables in `public`.
PAYLOAD_DATABASE_URI=

# Cloudflare R2 (media storage for the Media collection)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
# Public base URL files are served from - either the bucket's r2.dev URL or a
# custom domain you've mapped to the bucket. No trailing slash.
R2_PUBLIC_URL=
