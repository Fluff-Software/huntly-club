# Supabase — local: use ngrok URL + anon key from `supabase status`; hosted: use project URL + anon key from Supabase dashboard → Settings → API
# Auth emails (sign-up verification, password reset) are sent via Mailjet from Edge Functions; see repo root supabase/EDGE_FUNCTION_SECRETS.md for Mailjet config (set as Supabase secrets, not here).
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# MapTiler (Android walk/cycle maps via MapLibre). iOS walk/cycle maps use Apple Maps (no map API key).
# 1. Sign up: https://cloud.maptiler.com/
# 2. Create API key: https://cloud.maptiler.com/account/keys/new (do not use the default key for production)
# 3. After first dev build: restrict key (user-agent or signed requests) — see MapTiler usage logs for the User-Agent string
#    https://docs.maptiler.com/guides/maps-apis/maps-platform/how-to-protect-your-map-key/
# 4. Paste key below; required for EAS Android builds (add same name in Expo project env)
# 5. Native rebuild required after changing: `npx expo prebuild --clean` or EAS build
# google-services.json is for Firebase only — it does not provide map tiles.
# Style: streets-v2 (default). Alternatives: outdoor-v2, openstreetmap, topo-v2, satellite
EXPO_PUBLIC_MAPTILER_API_KEY=
# EXPO_PUBLIC_MAPTILER_STYLE_ID=streets-v2

# Explore API (Step 10.2 — Supabase Edge Functions are the default).
# Production / preview: Edge mode — no EXPO_PUBLIC_EXPLORE_API_URL required.
# DEV optional local Node side-by-side:
#   EXPO_PUBLIC_EXPLORE_TRANSPORT=local
#   EXPO_PUBLIC_EXPLORE_API_URL=http://localhost:4310
# Android Emulator local: http://10.0.2.2:4310
# Physical device LAN:    http://<your-lan-ip>:4310
# EXPO_PUBLIC_EXPLORE_TRANSPORT=edge
# EXPO_PUBLIC_EXPLORE_API_URL=
# Never put service-role keys in EXPO_PUBLIC_*.

# EAS — required for EAS Build and EAS Update (get from https://expo.dev, project settings)
EXPO_PUBLIC_EAS_PROJECT_ID=
EXPO_PUBLIC_OWNER=
