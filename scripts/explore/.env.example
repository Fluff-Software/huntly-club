# Local Explore backend — Supabase auth + claim RPC + national COPY import.
# Copy to .env and fill from the SAME hosted project as apps/mobile and apps/admin.
#
# From other env files (already aligned when present):
#   EXPLORE_SUPABASE_URL              ← EXPO_PUBLIC_SUPABASE_URL / SUPABASE_URL
#   EXPLORE_SUPABASE_ANON_KEY         ← EXPO_PUBLIC_SUPABASE_ANON_KEY
#   EXPLORE_SUPABASE_SERVICE_ROLE_KEY ← SUPABASE_SERVICE_ROLE_KEY (admin only)
#
# NEVER put a service-role key in apps/mobile or any EXPO_PUBLIC_* variable.
# NEVER bake secrets into the Docker image — inject at runtime.

EXPLORE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
EXPLORE_SUPABASE_ANON_KEY=
EXPLORE_SUPABASE_SERVICE_ROLE_KEY=

# Required for national bulk COPY import (Step 10.5). Not in mobile/admin .env files.
# Supabase dashboard → Project Settings → Database → Connection string → URI
# Prefer Session pooler or Direct connection, with sslmode=require.
# Example shape (password from Database settings; not an API key):
# EXPLORE_DATABASE_URL=postgresql://postgres.YOUR_REF:[YOUR-PASSWORD]@aws-0-….pooler.supabase.com:5432/postgres?sslmode=require

# Optional aliases: SUPABASE_URL, SUPABASE_ANON_KEY, SUPABASE_SERVICE_ROLE_KEY, DATABASE_URL

# Server bind (Cloud Run sets PORT automatically)
# EXPLORE_SERVER_PORT=4310
# EXPLORE_SERVER_HOST=0.0.0.0
# PORT=4310

# CORS: comma-separated origins, or * for open (dev only)
# EXPLORE_ALLOWED_ORIGINS=*
# EXPLORE_ALLOWED_ORIGIN=*

# Prepared OSM extract path (defaults to fixtures/local/stoke-sneyd-green.geojson)
# EXPLORE_OSM_DATA_PATH=

# Fail startup if auth/OSM not configured (set to 1 in hosted environments)
# EXPLORE_REQUIRE_AUTH_CONFIG=1

# Logging: debug | info | warn | error
# EXPLORE_LOG_LEVEL=info

# Claim rate limits
# EXPLORE_CLAIM_MIN_INTERVAL_MS=3000
# EXPLORE_CLAIM_MAX_FAILED_PER_WINDOW=20
# EXPLORE_CLAIM_FAILED_WINDOW_MS=60000

# Nearby / verify window limits (process-local)
# EXPLORE_NEARBY_MAX_PER_WINDOW=60
# EXPLORE_NEARBY_WINDOW_MS=60000
# EXPLORE_VERIFY_MAX_PER_WINDOW=30
# EXPLORE_VERIFY_WINDOW_MS=60000

# Optional award debug logging (never logs tokens)
# EXPLORE_DEV_LOG_AWARDS=1
